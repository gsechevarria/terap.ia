# Variables para la batería de INTEGRACIÓN (`npm run test:integration:*`).
#
# Copia a `.env.test` y rellena con los valores de tu Supabase LOCAL:
#
#   supabase start        # los imprime al arrancar
#   supabase status       # o los vuelve a mostrar
#
# Los scripts rechazan cualquier URL fuera de loopback HTTP.
# Crean datos ficticios y archivos en Supabase local y los conservan al terminar.
# CI utiliza una instancia desechable; no se ejecutan borrados automáticos.
#
# `.env.test` está en .gitignore, igual que `.env.local`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key que imprime supabase start>
SUPABASE_SERVICE_ROLE_KEY=<service_role key que imprime supabase start>

# Solo para npm run seed; contraseña elegida para las cuentas de demostración.
SEED_PASSWORD=elige-una-clave-local-de-12-caracteres
