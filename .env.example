# Supabase — proyecto en EU (Frankfurt).
# Copia este archivo a .env.local y rellena con tus valores reales.
# .env.local NUNCA se sube al repositorio (ver .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu-anon-key

# Clave SECRETA (service_role). SOLO para scripts de servidor (p. ej. test:rls)
# y el cron de notificaciones. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...o-service_role-jwt

# Web Push (VAPID). Genera con: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...clave-publica
VAPID_PRIVATE_KEY=...clave-privada
VAPID_SUBJECT=mailto:soporte@terap.ia
# Secreto para autorizar el endpoint de cron de envío (/api/cron/notifications).
# Se envía SOLO como cabecera `Authorization: Bearer ...` (Vercel Cron lo hace
# automáticamente); el endpoint ya no acepta el secreto por query string.
CRON_SECRET=cadena-aleatoria

# URL pública del despliegue, SIN barra final (p. ej. https://terap.ia).
# La usan los enlaces de invitación, que llevan el token en el path: no puede
# derivarse de cabeceras (`x-forwarded-host` lo controla quien llama).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zona horaria del proceso. Red de seguridad: el runtime de Vercel es UTC.
# El código NO debe depender de esta variable — toda la aritmética y el formateo
# de fechas fija la zona explícitamente en src/lib/tz.ts. Si la borras, la app
# debe seguir mostrando las horas correctas.
TZ=Europe/Madrid


# Telemetría desactivada salvo activación explícita. Sin trazas ni texto libre.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
# Mantener desactivado: el emisor FCM/APNs todavía no está implementado.
NEXT_PUBLIC_NATIVE_PUSH_ENABLED=false
# Banner visible por defecto; no retirar hasta validar el entorno para datos reales.
NEXT_PUBLIC_DEMO_MODE=true
