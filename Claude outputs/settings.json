{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm ci:*)",
      "Bash(npm audit:*)",
      "Bash(npm ls:*)",
      "Bash(node --version)",
      "Bash(npx supabase status:*)",
      "Bash(npx supabase migration list:*)",
      "Bash(npx supabase start:*)",
      "Bash(npx supabase stop:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(node scripts/write-local-env.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh repo view:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npm run db:push:*)",
      "Bash(supabase migration repair:*)",
      "Bash(npx supabase migration repair:*)",
      "Bash(supabase link:*)",
      "Bash(npx supabase link:*)",
      "Bash(npm run gen:types:*)",
      "Bash(npm run seed:*)",
      "Bash(npm audit fix:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-agente.mjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
