{
  "name": "terapia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:push": "supabase db push",
    "gen:types": "supabase gen types typescript --project-id levufuoigdlexscpvlgk --schema public > src/lib/database.types.ts",
    "gen:icons": "node scripts/gen-icons.mjs",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#4f9d8b' --splashBackgroundColor '#f7f7f5'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration:rls": "node --env-file=.env.test scripts/test-rls.mjs",
    "test:integration:pro": "node --env-file=.env.test scripts/test-pro-flow.mjs",
    "test:integration:onboarding": "node --env-file=.env.test scripts/test-onboarding.mjs",
    "test:integration:scales": "node --env-file=.env.test scripts/test-scales.mjs",
    "test:integration:agenda": "node --env-file=.env.test scripts/test-agenda.mjs",
    "test:integration:payments": "node --env-file=.env.test scripts/test-payments.mjs",
    "test:integration:wellbeing": "node --env-file=.env.test scripts/test-wellbeing.mjs",
    "test:integration:notifications": "node --env-file=.env.test scripts/test-notifications.mjs",
    "test:integration:analytics": "node --env-file=.env.test scripts/test-analytics.mjs",
    "test:integration:contabilidad": "node --env-file=.env.test scripts/test-contabilidad.mjs",
    "test:integration": "npm run test:integration:rls && npm run test:integration:pro && npm run test:integration:onboarding && npm run test:integration:scales && npm run test:integration:agenda && npm run test:integration:payments && npm run test:integration:wellbeing && npm run test:integration:notifications && npm run test:integration:analytics && npm run test:integration:contabilidad"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.11"
  }
}
